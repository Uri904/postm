    {
      "name": "Autenticación",
      "description": "Obtiene tokens Bearer para usuario normal y administrador.",
      "item": [
        {
          "name": "Obtener token de usuario (POST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde con token Bearer', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().tokenType).to.eql('Bearer'); });",
                  "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usuario}}\",\n  \"contrasena\": \"{{contrasena}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/token"
          }
        },
        {
          "name": "Admin: obtener token (POST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde con token Bearer de admin', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().tokenType).to.eql('Bearer'); });",
                  "pm.collectionVariables.set('adminAccessToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin}}\",\n  \"contrasena\": \"{{adminContrasena}}\"\n}",
